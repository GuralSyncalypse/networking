# ZeroHost Linux - copy file này thành `.env` rồi điền giá trị.
# .env được nạp tự động từ: thư mục chứa host_linux.py -> thư mục hiện tại.
# Biến đã có trong môi trường (systemd, docker, export ...) luôn được ưu tiên hơn .env.

# Endpoint gateway nhận URL công khai (POST JSON {"url": "..."}).
DEFAULT_GATEWAY_UPDATE_URL=https://pgt-energy.onrender.com/_gateway/update

# Token Bearer gửi kèm request. Để trống => bỏ qua bước cập nhật gateway.
UPDATE_TOKEN=

# URL cố định đã có sẵn (named tunnel / domain riêng).
# Nếu đặt biến này, host_linux.py KHÔNG chạy quick tunnel mà chỉ đẩy URL này lên gateway.
PUBLIC_URL=

# Thư mục cần chia sẻ. Để trống => dùng thư mục hiện tại (hoặc -d/--dir).
HOST_DIR=

# Cổng HTTP server cục bộ (hoặc -p/--port).
PORT=8069
